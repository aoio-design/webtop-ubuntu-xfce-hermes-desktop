#!/usr/bin/with-contenv bash
# =============================================================================
# 08-desktop-password — never leave the desktop login on a placeholder password
# =============================================================================
# The compose file ships a default PASSWORD so the stack starts without you
# editing anything. That default is fine on a machine nobody can reach and wrong
# the moment the port is published to the internet — which is exactly what the
# one-click deployment does. A browser login of "changeme" on a Docker host is
# how machines get found.
#
# So: if PASSWORD is missing or is one of the placeholders, this hook replaces it
# with a generated one and tells you where to find it. If you set a real
# password, nothing here touches it.
#
# HOW IT REACHES THE LOGIN: s6 keeps a service's environment in
# /run/s6/container_environment, and every LinuxServer init service starts with
# `with-contenv`, which re-reads that directory when the service starts.
# init-custom-files (this directory) runs BEFORE init-services, so writing the
# variable here is writing it before nginx and the desktop read it.
#
# The generated value is also stored at /config/.desktop-password (mode 600,
# owned by the desktop user) so it stays the same across restarts and recreates
# instead of changing under you.
#
# Escape hatch: set PASSWORD in the compose file to anything that is not a
# placeholder and this hook does nothing at all.

set -u

ENVDIR=/run/s6/container_environment
PWFILE=/config/.desktop-password
LOG=/config/logs/desktop-password.log

mkdir -p /config/logs 2>/dev/null || true
pw_log() { printf '%s desktop-password: %s\n' "$(date -Is)" "$*" | tee -a "$LOG"; }

CURRENT="${PASSWORD:-}"

is_placeholder() {
  case "$1" in
    ""|changeme|change-me|changethis|password|admin|webtop|secret) return 0 ;;
    *) return 1 ;;
  esac
}

if ! is_placeholder "$CURRENT"; then
  pw_log "PASSWORD is set by you — leaving it alone"
  exit 0
fi

if [ -s "$PWFILE" ]; then
  NEW="$(cat "$PWFILE")"
  SOURCE="reused the password generated on an earlier boot"
else
  # 24 characters from the alphanumerics only: no quoting, no shell metacharacters,
  # nothing that has to be escaped when somebody types it into the login box.
  NEW="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24)"
  SOURCE="generated a new password"
fi

if [ -z "$NEW" ]; then
  pw_log "FAIL: could not generate a password — leaving the placeholder in place"
  exit 1
fi

printf '%s' "$NEW" > "$ENVDIR/PASSWORD"

( umask 077; printf '%s' "$NEW" > "$PWFILE" )
chown abc:abc "$PWFILE" 2>/dev/null || true
chmod 600 "$PWFILE" 2>/dev/null || true

pw_log "$SOURCE; the desktop login is user '$CUSTOM_USER' and the password in $PWFILE"
pw_log "read it in the browser UI with:  docker exec <container> cat $PWFILE"
exit 0
