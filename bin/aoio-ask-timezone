#!/bin/bash
# =============================================================================
# aoio-ask-timezone — ask the buyer, once, which city they are in
# =============================================================================
# Why this exists: the machine's clock is not something a non-technical buyer can
# write into a docker-compose file, and TZ is a container-level value, so nothing
# inside the container can change it by itself. The image therefore owns the
# clock: this asks once, on the first desktop session, and writes the answer to
# /config/.timezone (which lives on the mounted volume). The boot hook
# custom-cont-init.d/15-timezone re-applies it at every start, so the choice
# survives a container update or recreate — the one kind of change that is safe
# inside a container (see the image README's container-layer rule).
#
# Rules:
#   * an explicit TZ in the buyer's compose always wins — then this asks nothing;
#   * already answered, or answered "no thanks" three times -> silent, so it is
#     safe to run from autostart on every session;
#   * cancelled or no match -> nothing is written, and it asks again next session;
#   * the desktop user answers, but only /etc/localtime needs root, so it
#     escalates with sudo -n for that one step (the buyer's compose gives abc
#     passwordless sudo inside the container).
#
# Runnable by hand, which is how it is tested (no desktop, no zenity needed):
#   aoio-ask-timezone --print            # what the clock is set to now
#   aoio-ask-timezone --zone Asia/Tokyo # set it without a dialog
#   aoio-ask-timezone --list london      # what a city name matches

set -u

ZONE_FILE=/config/.timezone
CANCEL_FILE=/config/.timezone-cancelled
ZONEINFO=/usr/share/zoneinfo
LOG=/config/logs/timezone.log
MAX_CANCELS=3
# The dialog waits for the desktop and the agent's app to settle first, so it is
# not racing the app's own autostart entry for the screen.
SLEEP_FIRST="${AOIO_TZ_SLEEP:-15}"

log() { { mkdir -p "$(dirname "$LOG")" 2>/dev/null; printf '%s ask-timezone: %s\n' "$(date -Is)" "$*" >> "$LOG"; } 2>/dev/null || true; }

# Anything that is a real time zone: a file under /usr/share/zoneinfo with a
# region directory, excluding the directories that are not zones (posix/right
# copies, Etc/GMT-8 style aliases, the tz database's own text files).
is_zone() {
  case "$1" in
    posix/*|right/*|Etc/*|SystemV/*|*zone.tab|*zone1970.tab|*iso3166.tab|*leapseconds|*tzdata.zi|*/) return 1 ;;
  esac
  case "$1" in */*) [ -f "$ZONEINFO/$1" ] && return 0 ;; esac
  return 1
}

current_zone() {
  if [ -n "${TZ:-}" ] && is_zone "$TZ"; then printf '%s' "$TZ"; return 0; fi
  if [ -f "$ZONE_FILE" ]; then tr -d ' \n' < "$ZONE_FILE"; return 0; fi
  if [ -L /etc/localtime ]; then
    readlink /etc/localtime | sed "s|^$ZONEINFO/||"
    return 0
  fi
  printf 'UTC (not set)'
}

# City or country name -> candidate zones, best first: an exact match on the last
# path component ("singapore" -> Asia/Singapore) beats a substring, and a shorter
# path beats a longer one ("london" -> Europe/London, not Europe/Isle_of_Man...).
matches() {
  local q
  q="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr '_' ' ')"
  find "$ZONEINFO" -type f 2>/dev/null | sed "s|^$ZONEINFO/||" |
    while read -r z; do
      is_zone "$z" || continue
      printf '%s' "$z" | tr '[:upper:]' '[:lower:]' | tr '_' ' ' | grep -q -- "$q" && printf '%s\n' "$z"
    done |
    awk -v q="$q" '{ n=tolower($0); gsub("_"," ",n); sub(".*/","",n); print (n==q?0:1), length($0), $0 }' |
    sort -k1,1n -k2,2n | cut -d' ' -f3-
}

apply_zone() {
  if ! is_zone "$1"; then log "refused: '$1' is not a time zone"; return 1; fi
  printf '%s\n' "$1" > "$ZONE_FILE" 2>/dev/null || { log "cannot write $ZONE_FILE"; return 1; }
  if ! ln -sfn "$ZONEINFO/$1" /etc/localtime 2>/dev/null; then
    sudo -n ln -sfn "$ZONEINFO/$1" /etc/localtime 2>/dev/null || { log "cannot set /etc/localtime"; return 1; }
  fi
  rm -f "$CANCEL_FILE" 2>/dev/null || true
  log "clock set to $1"
  return 0
}

cancel_count() { [ -f "$CANCEL_FILE" ] && tr -dc '0-9' < "$CANCEL_FILE" || printf '0'; }

# ------------------------------------------------------------------ by hand
case "${1:-}" in
  --print) current_zone; printf '\n'; exit 0 ;;
  --zone) shift; apply_zone "${1:?usage: --zone <Area/City>}" && { current_zone; printf '\n'; exit 0; }; exit 1 ;;
  --list) shift; matches "${1:?usage: --list <city>}"; exit 0 ;;
  -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
esac

[ -f "$LOG" ] || mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

# ------------------------------------------------------- nothing to ask about
if [ -n "${TZ:-}" ] && is_zone "$TZ"; then
  log "compose sets TZ=$TZ — nothing to ask"
  exit 0
fi
if [ -f "$ZONE_FILE" ] && is_zone "$(tr -d ' \n' < "$ZONE_FILE")"; then exit 0; fi
if [ "$(cancel_count)" -ge "$MAX_CANCELS" ]; then exit 0; fi
if ! command -v zenity >/dev/null 2>&1; then
  log "zenity is not installed — leaving the clock on UTC"
  exit 0
fi

[ "${AOIO_TZ_SLEEP:-}" = "0" ] || sleep "$SLEEP_FIRST"
[ -n "${DISPLAY:-}" ] || export DISPLAY=:1

# ------------------------------------------------------------------- asking
answer="$(zenity --title="Your cloud computer's clock" \
  --entry --width=460 \
  --text="Which city or region are you in?\n\nThis sets this machine's clock, once. Use the nearest big city — for example: Singapore, London, New York, Sydney." 2>/dev/null)" || {
  n=$(( $(cancel_count) + 1 )); printf '%s\n' "$n" > "$CANCEL_FILE" 2>/dev/null || true
  log "dismissed (${n}/$MAX_CANCELS) — will ask again next session"
  exit 0
}
[ -n "$answer" ] || exit 0

list="$(matches "$answer")"
count="$(printf '%s\n' "$list" | grep -c . || true)"
if [ "$count" = "0" ]; then
  zenity --warning --width=460 \
    --text="I could not find a time zone matching \"$answer\".\n\nTry the nearest big city: Singapore, London, New York, Tokyo, Sydney." 2>/dev/null
  log "no match for '$answer'"
  exit 0
fi
if [ "$count" -gt 1 ]; then
  zone="$(printf '%s\n' "$list" | head -25 | zenity --list --width=460 --height=380 \
    --title="Which one?" --text="More than one place matches \"$answer\" — pick yours:" \
    --column="Time zone" 2>/dev/null)"
else
  zone="$list"
fi
[ -n "${zone:-}" ] || { log "no zone chosen for '$answer'"; exit 0; }

if apply_zone "$zone"; then
  zenity --info --width=460 \
    --text="Your machine's clock is now on $zone.\n\n$(date '+%A %H:%M, %d %B %Y') on this machine." 2>/dev/null
else
  zenity --warning --width=460 \
    --text="I could not set that time zone on this machine.\n\nAsk your agent to set it from this file: $ZONE_FILE" 2>/dev/null
  exit 1
fi
